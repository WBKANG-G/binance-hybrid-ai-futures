+# Optional independent worker; uses the API image already built by hybrid-windows.
+services:
+  demo_restart_guard:
+    image: hybrid-windows-api
+    profiles: [open-api-restart-check]
+    command: [python, -m, scripts.check_demo_open_api_restart, --preview]
+    environment:
+      TRADING_MODE: PAPER
+      LIVE_TRADING_ENABLED: "false"
