+    assert "DO_NOT_RETAIN" not in serialized and "PRIVATE" not in serialized
+    assert all(set(r) == {"e", "E", "received_local_ms", "clock_sample"} for r in capture.hints)
+    report = asyncio.run(m.replay(capture.hints))
