+    assert order.signal.suggested_limit_price == Decimal("80000.1")
+    assert order.signal.target_price == Decimal("80800.2")
+    assert order.signal.initial_stop_price == Decimal("79600")
+    assert order.quantity == Decimal("0.0007")
