+                **details,
+                "database_changed": False,
+                "orders_enabled": False,
+                "live_trading_enabled": False,
+            }
+        ),
+        flush=True,
+    )
+    if code != "READY":
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
