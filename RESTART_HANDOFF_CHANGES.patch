+def test_waiter_rejects_live_before_database(monkeypatch, capsys):
+    monkeypatch.setattr("sys.argv", ["wait", "--operation-id", str(uuid4())])
+    monkeypatch.setenv("LIVE_TRADING_ENABLED", "true")
