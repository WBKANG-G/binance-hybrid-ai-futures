+        ("filled", "ENTRY_FILLED"),
+        ("expiry", "ENTRY_TOO_CLOSE_TO_EXPIRY"),
+        ("tag", "WAITING_FOR_READY"),
+        ("fence", "WAITING_FOR_READY"),
+    ],
+)
+def test_waiter_never_signals_restart_with_stale_or_invalid_guard_state(
