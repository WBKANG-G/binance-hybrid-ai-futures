+def verify_sources():
+    require(
+        all(
+            Path(n).is_file() and hashlib.sha256(Path(n).read_bytes()).hexdigest() == h
+            for n, h in NEW_PINS.items()
+        ),
+        "INSTALLED_SOURCE_HASH_MISMATCH",
+    )
