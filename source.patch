+
+@pytest.mark.parametrize("phase", ["cleanup", "admitted", "stopped"])
+def test_preparation_cannot_reopen_closed_or_already_admitted_scope(setup, phase):  # noqa: F811
+    b, _, calls, _ = setup
+    call(b, TIME)
+    if phase == "cleanup":
