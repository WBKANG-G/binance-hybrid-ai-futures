+
+        async def forbidden():
+            pytest.fail("idle wait must not invalidate or introduce extra delay")
+
+        with pytest.raises(TimeoutError):
+            await inbox.take(timeout=0.001, before_coalesce=forbidden)
+        await close(reader)
+
+    asyncio.run(run())
+
