+                "ENTRY_SCOPE_INVALID",
+                "RECOVERY_ONLY",
+                "OPERATION_ALREADY_EXISTS",
+                "STOP_PROOF_NOT_VERIFIED",
+                "REPEATED_INJECTION",
+                "UNEXPECTED_TP_TRANSPORT",
+                "FAULT_NOT_OBSERVED",
