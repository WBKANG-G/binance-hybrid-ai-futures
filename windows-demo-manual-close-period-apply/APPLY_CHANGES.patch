+def reviewed(report, *, evidence=True):
+    for key, value in EXPECTED.items():
+        actual = report.get(key)
+        if key.endswith("usdt") or key == "high_water_usdt_preserved":
+            require(Decimal(str(actual)) == Decimal(value), "REVIEWED_VALUES_CHANGED")
+        else:
+            require(actual == value, "REVIEWED_VALUES_CHANGED")
+    if evidence:
+        require(
+            all(
+                report.get(k) is True
+                for k in (
+                    "operator_attestation_used",
+                    "prior_attested_day_receipt_verified",
+                    "signed_btc_trade_cohort_reverified",
+                    "post_anchor_income_empty",
+                    "current_exchange_empty_at_read_checks",
+                    "old_valuation_timestamp_preserved",
+                    "request_history_preserved",
+                    "manual_close_receipt_preserved",
+                )
+            )
+            and all(
+                report.get(k) is False
+                for k in (
+                    "exact_day_midnight_valuation_verified",
+                    "exact_week_midnight_valuation_verified",
+                    "account_wide_trade_export_verified",
+                    "database_changed_by_preview",
+                    "baseline_adoption_approved",
+                )
+            ),
+            "REVIEWED_EVIDENCE_CHANGED",
+        )
