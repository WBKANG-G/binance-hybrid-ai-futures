+def adopt(
+    store,
+    client,
+    monitor,
+    *,
+    attest=False,
+    attested_day=None,
+    accept_operator_evidence=False,
+    progress=None,
+):
+    require(attest is True, "OPERATOR_ATTESTATION_REQUIRED")
+    require(accept_operator_evidence is True, "MANUAL_SOURCE_ACCEPTANCE_REQUIRED")
+    progress = progress if progress is not None else {}
+    before = local(store)[-1]
+    if recorded(before):
+        return result(before, changed=False, released=True)
+    _, anchor, day, week, boundary, week_boundary = context(store, before, client)
+    require(
+        attested_day == day == EXPECTED["operator_attested_day_kst"],
+        "CURRENT_DAY_ATTESTATION_REQUIRED",
+    )
+    reviewed(
+        {
+            "old_day_kst": before.daily_key,
+            "proposed_day_kst": day,
+            "old_week_kst": before.weekly_key,
+            "proposed_week_kst": week,
+            "old_daily_base_usdt": str(before.daily_base),
+            "proposed_daily_base_usdt": str(before.value.equity),
+            "old_weekly_base_usdt": str(before.weekly_base),
+            "proposed_weekly_base_usdt": str(before.value.equity),
+            "high_water_usdt_preserved": str(before.high_water),
+            "day_boundary_utc": boundary.isoformat(),
+            "week_boundary_utc": week_boundary.isoformat(),
+            "adoption_snapshot_anchor_utc": anchor.isoformat(),
+            "prior_attested_day_operation_id": PRIOR_DAY_KEY,
+            "operator_attested_day_kst": attested_day,
+        },
+        evidence=False,
+    )
+    progress["lease_change_possible"] = True
+    lease = store.acquire(ACCOUNT, uuid4())
+    try:
+        current = local(store, lease)[-1]
+        require(
+            current
+            == before.model_copy(deep=True, update={"reconciled": False, "stream_ready": False}),
+            "LOCAL_STATE_CHANGED",
+        )
+
+        def write(ledger):
+            require(ledger == current and not recorded(ledger), "LOCAL_STATE_CHANGED")
+            report = preview(
