+            receipt = AttestedPeriodBaseline(
+                review_token=digest(EXPECTED),
+                source=SOURCE,
+                day_boundary_utc=datetime.fromisoformat(EXPECTED["day_boundary_utc"]),
+                week_boundary_utc=datetime.fromisoformat(EXPECTED["week_boundary_utc"]),
+                baseline_usdt=Decimal(EXPECTED["proposed_daily_base_usdt"]),
+                old_daily_key=ledger.daily_key,
+                old_daily_base=ledger.daily_base,
+                old_weekly_key=ledger.weekly_key,
+                old_weekly_base=ledger.weekly_base,
+                anchor_utc=ledger.value.as_of,
+                signed_evidence_until_utc=datetime.fromtimestamp(
+                    report["signed_history_cutoff_ms"] / 1000, UTC
+                ),
+                attested_until_utc=store.now(),
+                signed_evidence_hash=proof_hash,
+                exchange_fingerprint=digest(
+                    {
+                        "scope": "GLOBAL_CURRENT_FLAT_USDT",
+                        "wallet": EXPECTED["proposed_daily_base_usdt"],
+                        "cutoff_ms": report["signed_history_cutoff_ms"],
+                    }
+                ),
+            )
+            ledger.daily_key, ledger.weekly_key = (
+                EXPECTED["proposed_day_kst"],
+                EXPECTED["proposed_week_kst"],
+            )
+            ledger.daily_base = ledger.weekly_base = receipt.baseline_usdt
+            ledger.attested_period_baselines[APPLY_KEY] = receipt
+            ledger.operations[APPLY_KEY] = json.dumps(
+                {
+                    "operation": OPERATION,
+                    "reviewed_values": EXPECTED,
+                    "evidence_source": "OPERATOR_ATTESTED_SIGNED_EXTERNAL_CLOSE_FLAT_ANCHOR",
+                    "preserved_ledger_sha256": original,
+                    "typed_receipt_sha256": digest(receipt.model_dump(mode="json")),
+                    "signed_history_cutoff_ms": report["signed_history_cutoff_ms"],
+                    "exact_day_midnight_valuation_verified": False,
+                    "exact_week_midnight_valuation_verified": False,
+                    "account_wide_exchange_export_verified": False,
+                },
+                sort_keys=True,
+            )
+            require(preserved(ledger) == original and recorded(ledger), "UNRELATED_LEDGER_CHANGE")
+
+        progress["application_may_have_completed"] = True
+        store.change(lease, "DEMO_EXTERNAL_CLOSE_ATTESTED_PERIOD_BASELINES", write)
+    finally:
