+"""Explicit one-order DEMO WSS fault/reconnect test; no API restart or host command."""
+
+import argparse
+import asyncio
+import json
+import os
+from pathlib import Path
+from uuid import UUID, uuid4
+
+import yaml
+from sqlalchemy import create_engine
+
+from integrations.binance_usdm.demo import DemoSettings
+from packages.domain.config import UniqueKeyLoader, database_url
+from packages.persistence.demo import DemoStore
+from scripts.demo_key_session import credentials
+from scripts.observe_demo_private import ACCOUNT
+from services.execution.demo import DemoCoordinator
+from services.execution.demo_api_restart_check import RestartClient, empty
+from services.execution.demo_open_disconnect_check import SocketCheckBlocked, failure_code, run
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--enable-demo", action="store_true", required=True)
+    parser.add_argument("--enable-fault-injection", action="store_true", required=True)
+    parser.add_argument("--operation-id", type=UUID, required=True)
+    args = parser.parse_args()
+    engine = store = lease = None
+    report = {
+        "disconnect_check": "BLOCKED",
+        "failure": "CHECK_FAILED",
+        "orders_enabled": False,
+        "live_trading_enabled": False,
+    }
+    success = False
+    try:
+        if (
+            os.getenv("LIVE_TRADING_ENABLED", "false").lower() != "false"
+            or os.getenv("TRADING_MODE", "PAPER") == "LIVE"
+        ):
+            raise SocketCheckBlocked("LIVE_CONTEXT_FORBIDDEN")
+        key = credentials(prompt=False)
+        cfg = DemoSettings.model_validate(
+            yaml.load(
+                Path("configs/demo-isolated.example.yaml").read_text(), Loader=UniqueKeyLoader
+            )
+        ).model_copy(update={"demo_trading_enabled": True})
+        client = RestartClient(cfg, key)
+        client.sync_clock()
+        engine = create_engine(
+            database_url().get_secret_value(), connect_args={"connect_timeout": 2}
+        )
+        store = DemoStore(engine)
+        lease = store.acquire(ACCOUNT, uuid4())
+        coordinator = DemoCoordinator(store, lease, client)
+        state = store.read(ACCOUNT)
+        existing = state.orders.get(str(args.operation_id))
+        if existing is None:
+            empty(coordinator)
+        elif (
+            existing.signal.purpose != "DEMO_VALIDATION"
+            or existing.signal.direction != "LONG"
+            or existing.signal.symbol != "BTCUSDT"
+            or any(
+                k != str(args.operation_id) and (o.remaining or o.open_quantity)
+                for k, o in state.orders.items()
+            )
+        ):
+            raise SocketCheckBlocked("ENTRY_SCOPE_INVALID")
+        coordinator.refresh_metadata()
+        coordinator.reconcile()
+        report = asyncio.run(run(coordinator, args.operation_id))
+        success = report["disconnect_check"] == "OPEN_ORDER_SOCKET_LOSS_CANCEL_RECONNECT_VERIFIED"
+    except Exception as error:
+        report["failure"] = failure_code(error)
+    finally:
+        try:
+            if store is not None and lease is not None:
+                store.release(lease)
+        except Exception:
+            success = False
+            report = {
+                "disconnect_check": "BLOCKED",
+                "failure": "LEASE_RELEASE_FAILED",
+                "orders_enabled": False,
+                "live_trading_enabled": False,
+            }
+        finally:
+            if engine is not None:
+                engine.dispose()
+    print(json.dumps(report), flush=True)
+    if not success:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
