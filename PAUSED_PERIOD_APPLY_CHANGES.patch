+def test_cross_operation_namespace_conflict_blocks_before_network(case):
+    store, c, fake, *_ = case
+    acquire(case)
+    operation = uuid4()
+    store.change(
+        c.lease,
+        "TEST_OTHER_OPERATION",
+        lambda ledger: ledger.operations.update({str(operation): "OTHER"}),
