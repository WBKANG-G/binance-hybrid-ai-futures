+    original = store.read
+    once = [False]
+
+    def fail_at_exit(account):
+        ledger = original(account)
+        if not once[0] and any(o.exit_state == "SUBMITTING" for o in ledger.orders.values()):
+            once[0] = True
+            raise OSError("PRIVATE_DATABASE_URL")
+        return ledger
