+"""Preview a narrow local DEMO correction; applying requires its explicit token and ID."""
+
+import argparse
+import getpass
+import json
+import os
+import re
+import warnings
+from pathlib import Path
+from uuid import UUID, uuid4
+
+import yaml
+from sqlalchemy import create_engine
+from sqlalchemy.exc import SQLAlchemyError
+
+from integrations.binance_usdm.demo import DemoClient, DemoCredentials, DemoFailure, DemoSettings
+from packages.domain.config import UniqueKeyLoader, database_url
+from packages.persistence.demo import DemoStore
+from scripts.review_demo_recovery import blocked
+from services.execution.demo_cancelled_correction import (
+    CancelledCorrectionBlocked,
+    apply_correction,
+    review_correction,
+)
+from services.execution.demo_cancelled_history import CancelledHistoryBlocked
+from services.execution.demo_day_review import DayReviewBlocked
+from services.execution.demo_history_review import HistoryBlocked
+from services.risk.paper import RiskRejected
+
+ACCOUNT_ID = "DEMO-WINDOWS-ISOLATED-BTC-V1"
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--apply-correction")
+    parser.add_argument("--operation-id", type=UUID)
+    args = parser.parse_args()
+    if (
+        os.getenv("LIVE_TRADING_ENABLED", "false").lower() != "false"
+        or os.getenv("TRADING_MODE", "PAPER") == "LIVE"
+    ):
+        blocked("CORRECTION_CONTEXT", "LIVE_CONTEXT_FORBIDDEN")
+    if bool(args.apply_correction) != bool(args.operation_id) or (
+        args.apply_correction and not re.fullmatch(r"[0-9a-f]{64}", args.apply_correction)
+    ):
+        blocked("CORRECTION_ARGUMENTS", "REVIEW_TOKEN_AND_OPERATION_ID_REQUIRED")
+    engine = None
+    lease = None
+    store = None
+    stage = "CREDENTIAL_INPUT"
+    try:
+        warnings.simplefilter("error", getpass.GetPassWarning)
+        os.environ["BINANCE_DEMO_API_KEY"] = getpass.getpass("DEMO API Key (hidden): ")
+        os.environ["BINANCE_DEMO_API_SECRET"] = getpass.getpass("DEMO Secret (hidden): ")
+        stage = "CONFIGURATION"
+        cfg = DemoSettings.model_validate(
+            yaml.load(
+                Path("configs/demo-isolated.example.yaml").read_text(), Loader=UniqueKeyLoader
+            )
+        ).model_copy(update={"demo_trading_enabled": False})
+        client = DemoClient(cfg, DemoCredentials.from_environment())
+        stage = "CLOCK_CHECK"
+        client.sync_clock()
+        stage = "DATABASE_READ"
+        engine = create_engine(
+            database_url().get_secret_value(), connect_args={"connect_timeout": 2}
+        )
+        store = DemoStore(engine)
+        account = ACCOUNT_ID
+        if args.apply_correction:
+            stage = "CORRECTION_APPLY"
+            lease = store.acquire(account, uuid4())
+            result = apply_correction(
+                store, lease, client, args.operation_id, args.apply_correction
+            )
+            after = store.read(account)
+            print(
+                json.dumps(
+                    {
+                        "correction": result,
+                        "operation_id": str(args.operation_id),
+                        "risk_state": after.risk_state.value,
+                        "paused": after.paused,
+                        "unresolved_requests_acknowledged": False,
+                        "risk_baselines_changed": False,
+                        "recovery_eligible": False,
+                        "orders_enabled": False,
+                        "live_trading_enabled": False,
+                    }
+                )
+            )
+        else:
+            before = store.read(account)
+            stage = "CORRECTION_PREVIEW"
+            report = review_correction(store, client, before, account_id=account)
+            if store.read(account) != before:
+                raise CancelledCorrectionBlocked("DATABASE_CHANGED_DURING_REVIEW")
+            print(json.dumps(report))
+    except (
+        CancelledCorrectionBlocked,
+        CancelledHistoryBlocked,
+        DayReviewBlocked,
+        HistoryBlocked,
+    ) as error:
+        blocked(stage, str(error))
+    except getpass.GetPassWarning:
+        blocked(stage, "HIDDEN_INPUT_UNAVAILABLE")
+    except DemoFailure:
+        blocked(stage, "DEMO_QUERY_OR_SNAPSHOT_FAILED")
+    except SQLAlchemyError:
+        blocked(stage, "DATABASE_ACCESS_FAILED")
+    except RiskRejected:
+        blocked(stage, "LEASE_OR_RISK_GATE_REJECTED")
+    except (ValueError, EOFError):
+        blocked(stage, "INPUT_OR_CONFIGURATION_INVALID")
+    finally:
+        os.environ.pop("BINANCE_DEMO_API_KEY", None)
+        os.environ.pop("BINANCE_DEMO_API_SECRET", None)
+        try:
+            if lease is not None and store is not None:
+                store.release(lease)
+        except (RiskRejected, SQLAlchemyError):
+            blocked("LEASE_RELEASE", "LEASE_RELEASE_NOT_CONFIRMED_KEEP_LOCK")
+        finally:
+            if engine is not None:
+                engine.dispose()
+
+
+if __name__ == "__main__":
+    main()
