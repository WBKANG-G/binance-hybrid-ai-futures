+    assert "SYNTHETIC_PRIVATE_INPUT" not in output
+    assert "BINANCE_DEMO_API_KEY" not in os.environ and "BINANCE_DEMO_API_SECRET" not in os.environ
+    assert original_read("DEMO-test").model_dump_json() == before
