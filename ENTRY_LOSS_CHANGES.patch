+    final = store.read(lease.account_id)
+    order = final.orders.get(key)
+    fixed_fields = (
+        "policy",
+        "daily_key",
+        "daily_base",
+        "weekly_key",
+        "weekly_base",
+        "high_water",
+        "net_transfers",
+        "margin_mode",
+        "symbols",
+        "recovery_receipts",
+        "cancelled_exposure_corrections",
+        "attested_day_baselines",
+        "attested_period_baselines",
+        "exit_anchored_day_baselines",
+    )
