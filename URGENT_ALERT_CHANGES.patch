+def pending(case):
+    store, c, _ = case
+    c.command(uuid4(), "EMERGENCY_FLATTEN")
+    with store.engine.connect() as conn:
+        rows = conn.execute(select(alerts)).mappings().all()
+    assert len(rows) == 1
+    return rows[0]
+
