+    assert len(posts(fake)) == 1
+
+
+def test_wrong_direction_for_existing_operation_is_rejected_before_session(case, monkeypatch):
+    store, c, fake, _ = case
+    operation = uuid4()
+    asyncio.run(exercise(c, operation, "LONG", monkeypatch))
