+                "FINAL_STATE_NOT_VERIFIED",
+                "RESULT_AUDIT_FAILED",
+                "LEASE_RELEASE_FAILED",
+                "CHECK_FAILED",
+            }
+            else "CHECK_FAILED"
+        )
+        super().__init__(self.code)
