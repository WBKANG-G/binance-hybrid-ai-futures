+class StabilityBlocked(DemoFailure):
+    def __init__(self, code: str):
+        self.code = (
+            code
+            if code
+            in {
+                "LIVE_CONTEXT_FORBIDDEN",
+                "READ_ONLY_CLIENT_REQUIRED",
+                "OPERATION_ALREADY_EXISTS",
+                "READY_TIMEOUT",
+                "SESSION_ENDED_EARLY",
+                "SESSION_NOT_READY",
