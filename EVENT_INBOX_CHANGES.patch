+def test_idle_timeout_does_not_cancel_receiver_or_create_failure():
+    async def run():
+        inbox, task, failures = await ready([])
+        with pytest.raises(TimeoutError):
+            await inbox.take(timeout=0.001)
+        assert not task.done() and not failures
+        await close(task)
