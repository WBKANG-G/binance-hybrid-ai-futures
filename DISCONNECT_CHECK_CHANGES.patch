+                {task, observation}, timeout=phase_timeout, return_when=asyncio.FIRST_COMPLETED
+            )
+            if task in done:
+                await task
+                raise CheckBlocked("RECONNECT_NOT_VERIFIED")
+            if observation not in done or not second_ready.is_set() or coordinator.session_failed:
