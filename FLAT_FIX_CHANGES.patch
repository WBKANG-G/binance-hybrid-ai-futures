+        assert c.confirm_flat() == "VERIFIED_FLAT"
+        assert 20 <= elapsed[0] < 40
+        assert c.flat_confirmation_diagnostic["confirmation_clock_probes"] >= 1
+        assert c.flat_confirmation_stage == "VERIFY"
