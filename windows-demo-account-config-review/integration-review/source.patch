+def receipt_proven_closed(ledger: DemoLedger, order: PaperOrder, now: datetime) -> bool:
+    """Candidate only: immutable closure proof, independent of later account valuation.
+
+    The existing caller still requires absence from BOTH fresh open lists.
+    Other active orders and full historical snapshots retain the original path.
+    This file is not imported by the installed runtime or any CLI.
+    """
+    if (
+        str(order.signal.signal_id) != INCIDENT
+        or ledger.orders.get(INCIDENT) is not order
+        or ledger.margin_mode != "ISOLATED"
+        or ledger.symbols != ("BTCUSDT",)
+        or order.position_state != PositionState.CLOSED
+        or order.remaining
+        or order.open_quantity
+        or order.actual_risk
+        or order.protected
+    ):
+        return False
+    try:
+        return _matches(ledger, now)
+    except (ValueError, TypeError, KeyError, DecimalException):
+        return False
