+        and raw.get("entry_order_id") == "28668115919"
+        and raw.get("manual_close_order_id") == "28668119491"
+        and raw.get("trade_ids") == ["554837511", "554838531"]
+        and Decimal(raw.get("net_usdt", "NaN")) == Decimal("-0.07032487")
